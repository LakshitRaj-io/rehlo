# Copy to .env.local (and add the same variables in Vercel → Project → Settings → Environment Variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://jiswvtkexckwuomrbxdc.supabase.co
# service_role / secret key. SERVER ONLY: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin password. Generate the hash with: npm run admin:hash -- "your-new-password"
# Without it, the original default password still works. Set it before going live.
ADMIN_PASSWORD_HASH=
# Optional: separate secret for signing admin session cookies (defaults to the service key).
# ADMIN_SESSION_SECRET=

# Optional: your site's address, used for canonical links, the sitemap and link-preview images.
# Defaults to Vercel's production address; set it once you have a custom domain.
# NEXT_PUBLIC_SITE_URL=https://rehlo.in

# Optional: enables the listings API (/api/v1) used by npm run listings. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LISTINGS_API_KEY=
# Where npm run listings sends requests (defaults to http://localhost:3000).
# REHLO_API_URL=https://your-site.vercel.app
