# Copy to .env.local (and add the same variables in Vercel → Project → Settings → Environment Variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://jiswvtkexckwuomrbxdc.supabase.co
# service_role / secret key. SERVER ONLY: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin password. Generate the hash with: npm run admin:hash -- "your-new-password"
# Without it, the original default password still works. Set it before going live.
ADMIN_PASSWORD_HASH=
# Optional: separate secret for signing admin session cookies (defaults to the service key).
# ADMIN_SESSION_SECRET=

# Optional: absolute site URL used for canonical links and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://rehlo.in
